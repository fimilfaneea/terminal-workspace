{
  "name": "terminal-workspace",
  "productName": "Terminal Workspace",
  "version": "0.4.0",
  "description": "Windows 11 Electron terminal workspace.",
  "license": "MIT",
  "author": "Fimil Faneea <fimil@americaninference.com>",
  "homepage": "https://github.com/fimilfaneea/terminal-workspace#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fimilfaneea/terminal-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/fimilfaneea/terminal-workspace/issues"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20",
    "electron": ">=41"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "dist:win": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "npm run build && playwright test"
  },
  "build": {
    "appId": "com.local.terminal-workspace",
    "productName": "Terminal Workspace",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@xterm/addon-canvas": "0.8.0-beta.48",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron-log": "5.4.3",
    "electron-window-state": "5.0.3",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "4.10.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.4",
    "@playwright/test": "1.60.0",
    "@types/node": "25.6.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.4.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
